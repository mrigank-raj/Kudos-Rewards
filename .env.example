# Copy to .env (or .env.local) and fill in from Supabase → Project Settings → API.
# Both values are public (shipped to the browser). Security is enforced by
# RLS and SECURITY DEFINER functions — never put the service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_APP_ENV=development
